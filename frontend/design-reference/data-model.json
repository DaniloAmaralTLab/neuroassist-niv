{
  "project": "neuroassist-niv",
  "status": "draft (BA)",
  "version": "0.1.0",
  "entities": {
    "Tenant": {
      "description": "Care unit — family or clinic (multi-tenant, schema-per-tenant)",
      "fields": {
        "id": {
          "type": "string",
          "pk": true
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "enum",
          "enum": [
            "family",
            "clinic"
          ]
        }
      }
    },
    "Patient": {
      "description": "Person monitored by the system",
      "fields": {
        "id": {
          "type": "string",
          "pk": true
        },
        "tenantId": {
          "type": "ref",
          "ref": "Tenant",
          "label": "name"
        },
        "name": {
          "type": "string"
        },
        "device": {
          "type": "ref",
          "ref": "EdgeDevice",
          "label": "status"
        }
      }
    },
    "Caregiver": {
      "description": "Person with dashboard access",
      "fields": {
        "id": {
          "type": "string",
          "pk": true
        },
        "tenantId": {
          "type": "ref",
          "ref": "Tenant",
          "label": "name"
        },
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "role": {
          "type": "enum",
          "enum": [
            "caregiver",
            "clinic_coordinator"
          ]
        }
      }
    },
    "GestureType": {
      "description": "Catalog of facial movement types (primitives) recognized by the detection engine — extensible (LBC Amendment 2, 2026-07-27). Registering a name here does NOT imply real support by the detection engine (see TODO[architect] in Framing §6.1/§7.1a/§9.3).",
      "fields": {
        "id": {
          "type": "string",
          "pk": true
        },
        "name": {
          "type": "string"
        }
      }
    },
    "Command": {
      "description": "Item in the patient's command catalog — gesture (simple or compound) mapped to a need (LBC Amendment 1, 2026-07-27)",
      "fields": {
        "id": {
          "type": "string",
          "pk": true
        },
        "patientId": {
          "type": "ref",
          "ref": "Patient",
          "label": "label"
        },
        "label": {
          "type": "string"
        },
        "urgency": {
          "type": "enum",
          "enum": [
            "emergency",
            "routine"
          ]
        },
        "primaryPrimitive": {
          "type": "ref",
          "ref": "GestureType",
          "label": "name"
        },
        "secondaryPrimitive": {
          "type": "ref",
          "ref": "GestureType",
          "label": "name",
          "nullable": true
        },
        "sensitivity": {
          "type": "enum",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "minGestureDurationMs": {
          "type": "int"
        },
        "maxGestureDurationMs": {
          "type": "int"
        }
      }
    },
    "Event": {
      "description": "Structured occurrence generated by the edge",
      "fields": {
        "id": {
          "type": "string",
          "pk": true
        },
        "patientId": {
          "type": "ref",
          "ref": "Patient",
          "label": "name"
        },
        "command": {
          "type": "ref",
          "ref": "Command",
          "label": "label"
        },
        "timestamp": {
          "type": "datetime"
        },
        "confirmedAt": {
          "type": "datetime",
          "nullable": true,
          "source": "mock"
        },
        "confirmedBy": {
          "type": "ref",
          "ref": "Caregiver",
          "label": "name"
        },
        "feedback": {
          "type": "enum",
          "enum": [
            "not_evaluated",
            "real",
            "false_positive"
          ]
        }
      }
    },
    "EdgeDevice": {
      "description": "Local (edge) agent that runs gesture detection",
      "fields": {
        "id": {
          "type": "string",
          "pk": true
        },
        "patientId": {
          "type": "ref",
          "ref": "Patient",
          "label": "name"
        },
        "status": {
          "type": "enum",
          "enum": [
            "online",
            "offline"
          ]
        },
        "lastSyncAt": {
          "type": "datetime"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "SpeechTreeNode": {
      "description": "Speech tree node of the CONV module — category or phrase (Amendment 3, 2026-08-30; ADR-013 accepted). Null parentId = tree root. Optional engineFeatureRef references the unified gesture vocabulary (commit 89f4ee5 of the real repository, see gest/frontend ADR-008 D4) to map a recognized gesture directly to a node — without a CONV-specific mapping table. NIV note: English-only product; pt-BR locale removed (see ADR-018-english-only-product); content keeps a per-locale map shape, but only the en locale is used. It holds text, audioRef (reference to the audio cached via ElevenLabs, ADR-017) and the Dual Authorization (caregiverConfirmed/patientConfirmed, ADR-016) that must complete before indexing in Elasticsearch (ADR-015).",
      "fields": {
        "id": { "type": "string", "pk": true },
        "patientId": { "type": "ref", "ref": "Patient", "label": "name" },
        "parentId": { "type": "ref", "ref": "SpeechTreeNode", "label": "text", "nullable": true },
        "type": { "type": "enum", "enum": ["category", "phrase"] },
        "content": {
          "type": "map",
          "keyEnum": ["en"],
          "valueFields": {
            "text": { "type": "string" },
            "audioRef": { "type": "string", "nullable": true },
            "caregiverConfirmed": { "type": "boolean" },
            "patientConfirmed": { "type": "boolean" }
          },
          "note": "Amendment 4 (2026-08-31), ADR-018 — was previously a single `text: { type: string }` (Amendment 3). Real migration: TODO[architect]."
        },
        "order": { "type": "int" },
        "engineFeatureRef": { "type": "string", "nullable": true },
        "proposedByTraining": { "type": "boolean", "note": "Amendment 4 — true if originated from the LLM in the TRAINING phase (ADR-016)" }
      }
    },
    "PatientSession": {
      "description": "Persistent app session of the patient on their own mobile phone, provisioned by the caregiver — does not expire, revocable at any time (Amendment 3, 2026-08-30; ADR-012 accepted, Option C: new actor in acs-service, distinct from caregiver and from edge device). Revocation reuses the JWT blacklist mechanism already existing in the real project (rbac/session-policy.md).",
      "fields": {
        "id": { "type": "string", "pk": true },
        "patientId": { "type": "ref", "ref": "Patient", "label": "name" },
        "provisionedBy": { "type": "ref", "ref": "Caregiver", "label": "name" },
        "deviceId": { "type": "ref", "ref": "EdgeDevice", "label": "status" },
        "status": { "type": "enum", "enum": ["active", "revoked"] },
        "provisionedAt": { "type": "datetime" },
        "revokedAt": { "type": "datetime", "nullable": true },
        "revokedBy": { "type": "ref", "ref": "Caregiver", "label": "name", "nullable": true }
      }
    }
  },
  "screenBindings": {
    "entry": {
      "reads": [
        "(none — static screen",
        "no operational data)"
      ],
      "writes": [
        "(none)"
      ]
    },
    "home": {
      "reads": [
        "Patient[]",
        "EdgeDevice[]",
        "Event[] (of the day",
        "with `Event.command` resolved to label + urgency)"
      ],
      "writes": [
        "(none at the moment — read-only)"
      ],
      "mock": {
        "patients": "mock-data.json#/patients",
        "devices": "mock-data.json#/devices",
        "commands": "mock-data.json#/commands",
        "events": "mock-data.json#/events"
      }
    },
    "alarm": {
      "reads": [
        "Event[] (same collection as Home/History; the active event is the most recent one whose `Command.urgency = emergency` and still without `confirmedAt` — it is not a separate collection)"
      ],
      "writes": [
        "Event.confirmedAt",
        "Event.confirmedBy"
      ],
      "mock": {
        "events": "mock-data.json#/events",
        "commands": "mock-data.json#/commands"
      }
    },
    "history": {
      "reads": [
        "Event[] (filtered by period",
        "with `Event.command` resolved to label + urgency)"
      ],
      "writes": [
        "Event.feedback"
      ],
      "mock": {
        "events": "mock-data.json#/events"
      }
    },
    "calibration": {
      "reads": [
        "Command[] (all of the active patient)",
        "GestureType[] (extensible catalog of primitives, Amendment 2)"
      ],
      "writes": [
        "Command (create/edit/remove)",
        "fields: label",
        "urgency",
        "primaryPrimitive",
        "secondaryPrimitive",
        "sensitivity",
        "GestureType (create new type — e.g.: \"Lip reading\" — directly in the command editor)"
      ],
      "mock": {
        "commands": "mock-data.json#/commands",
        "gestureTypes": "mock-data.json#/gestureTypes"
      }
    },
    "onboarding": {
      "reads": [
        "Tenant[]",
        "Patient[]",
        "EdgeDevice[]"
      ],
      "writes": [
        "Tenant",
        "Patient",
        "EdgeDevice",
        "Caregiver (creates the records)",
        "Command (optionally already creates the first command of the catalog",
        "if the operator fills it in on Screen 04 before going back)"
      ]
    },
    "conv-tree": {
      "reads": [
        "SpeechTreeNode[] (filtered by patientId and parentId of the active level)"
      ],
      "writes": [
        "(no direct writes — selecting a leaf node may generate an Event if mapped to a Command via engineFeatureRef)"
      ],
      "mock": {
        "speechTreeNodes": "mock-data.json#/speechTreeNodes"
      }
    },
    "phone-activation": {
      "reads": [
        "Patient[]",
        "EdgeDevice[]",
        "PatientSession[] (of the active patient)"
      ],
      "writes": [
        "PatientSession (create on activation; update status/revokedAt/revokedBy on revocation)"
      ],
      "mock": {
        "patientSessions": "mock-data.json#/patientSessions"
      }
    },
    "training": {
      "reads": [
        "SpeechTreeNode[] (filtered by proposedByTraining=true and incomplete Dual Authorization)"
      ],
      "writes": [
        "SpeechTreeNode (create proposal coming from the LLM or manual; update content.<locale>.caregiverConfirmed on approval)"
      ],
      "mock": {
        "speechTreeNodes": "mock-data.json#/speechTreeNodes"
      }
    },
    "training-confirmation": {
      "reads": [
        "SpeechTreeNode[] (filtered by patientId, content.<locale>.caregiverConfirmed=true, content.<locale>.patientConfirmed=false)"
      ],
      "writes": [
        "SpeechTreeNode.content.<locale>.patientConfirmed (and audioRef, on completing the Dual Authorization — simulated in the prototype)"
      ],
      "mock": {
        "speechTreeNodes": "mock-data.json#/speechTreeNodes"
      }
    }
  }
}
