"""Unit spec for the {{ module_name }} aggregate.

Pure domain: constructed with ``new``, no I/O, no framework. Extend it as the
real aggregate replaces the skeleton.
"""

from __future__ import annotations

import pytest

from {{ package_name }}.{{ module_id }}.domain.model import (
    Create{{ ModuleId }}Command,
    DomainError,
    {{ ModuleId }},
    {{ ModuleId }}Code,
)

{% if multi_tenancy_mode != "single" -%}
{{ tenant_column | upper }} = "11111111-1111-4111-8111-111111111111"
{% endif %}

def _valid() -> {{ ModuleId }}:
    return {{ ModuleId }}(
        name="Valid name",
{%- if multi_tenancy_mode != "single" %}
        {{ tenant_column }}={{ tenant_column | upper }},
{%- endif %}
        description="optional",
    )


class TestInvariants:
    def test_builds_from_valid_values(self) -> None:
        aggregate = _valid()

        assert aggregate.name == "Valid name"
        assert aggregate.id is not None
        assert aggregate.created_at is not None
{%- if multi_tenancy_mode != "single" %}
        assert aggregate.{{ tenant_column }} == {{ tenant_column | upper }}
{%- endif %}

    @pytest.mark.parametrize("bad_name", ["", "   ", "\t"])
    def test_name_is_required(self, bad_name: str) -> None:
        with pytest.raises(DomainError) as exc:
            {{ ModuleId }}(
                name=bad_name,
{%- if multi_tenancy_mode != "single" %}
                {{ tenant_column }}={{ tenant_column | upper }},
{%- endif %}
            )

        assert exc.value.code == "{{ MODULE_ID }}_NAME_REQUIRED"
{%- if multi_tenancy_mode != "single" %}

    def test_{{ tenant_slug }}_is_required(self) -> None:
        """Every query is scoped by it, so an aggregate without it is unusable."""
        with pytest.raises(DomainError) as exc:
            {{ ModuleId }}(name="Valid name", {{ tenant_column }}="")

        assert exc.value.code == (
            "{{ MODULE_ID }}_{{ tenant_slug | upper }}_REQUIRED"
        )
{%- endif %}


class TestBehaviour:
    def test_rename_changes_the_name_and_stamps_the_update(self) -> None:
        aggregate = _valid()
        assert aggregate.updated_at is None

        aggregate.rename("Renamed")

        assert aggregate.name == "Renamed"
        assert aggregate.updated_at is not None

    def test_rename_still_enforces_the_invariants(self) -> None:
        """A setter that bypasses validation is how aggregates rot."""
        aggregate = _valid()

        with pytest.raises(DomainError):
            aggregate.rename("  ")

    def test_create_factory_produces_a_valid_aggregate(self) -> None:
        command = Create{{ ModuleId }}Command(name="From command")

        aggregate = {{ ModuleId }}.create(
            command,
{%- if multi_tenancy_mode != "single" %}
            {{ tenant_column }}={{ tenant_column | upper }},
{%- endif %}
        )

        assert aggregate.name == "From command"
{%- if multi_tenancy_mode != "single" %}
        assert aggregate.{{ tenant_column }} == {{ tenant_column | upper }}
{%- endif %}


class Test{{ ModuleId }}Code:
    @pytest.mark.parametrize("value", ["ABC", "A1_B-2", "X" * 32])
    def test_accepts_valid_codes(self, value: str) -> None:
        assert str({{ ModuleId }}Code(value)) == value

    @pytest.mark.parametrize(
        "value",
        ["ab", "A", "_ABC", "abc", "A" * 33, "WITH SPACE", ""],
    )
    def test_rejects_invalid_codes(self, value: str) -> None:
        with pytest.raises(DomainError) as exc:
            {{ ModuleId }}Code(value)

        assert exc.value.code == "{{ MODULE_ID }}_INVALID_CODE"
