"""Request-scoped dependencies for the {{ module_name }} HTTP adapter."""

from __future__ import annotations

from collections.abc import AsyncIterator
from dataclasses import dataclass

{% if multi_tenancy_mode != "single" -%}
from fastapi import Depends, HTTPException, Request, status
{%- else -%}
from fastapi import Depends
{%- endif %}
from sqlalchemy.ext.asyncio import AsyncSession

from {{ package_name }}.{{ module_id }}.application.services import (
    {{ ModuleId }}ApplicationService,
)
from {{ package_name }}.{{ module_id }}.infrastructure.persistence.session import session_factory
from {{ package_name }}.{{ module_id }}.infrastructure.security.jwt_middleware import (
    AuthenticatedPrincipal,
    require_principal,
)


@dataclass(frozen=True, slots=True)
class CurrentUser:
    """Authenticated caller, projected from the validated JWT."""

    subject: str
    username: str
    roles: frozenset[str]

    def has_authority(self, authority: str) -> bool:
        return authority in self.roles

{% if multi_tenancy_mode != "single" %}
@dataclass(frozen=True, slots=True)
class {{ tenant_class }}Context:
    """Resolved {{ multi_tenancy_term }} for the current request."""

    {{ tenant_column }}: str
    schema: str

{% endif %}
async def get_db() -> AsyncIterator[AsyncSession]:
    """Yield an AsyncSession and guarantee rollback on failure."""
    async with session_factory() as session:
        try:
            yield session
            await session.commit()
        except Exception:
            await session.rollback()
            raise


async def get_current_user(
    principal: AuthenticatedPrincipal = Depends(require_principal),
) -> CurrentUser:
    """Expose the validated principal as the adapter-level user model."""
    return CurrentUser(
        subject=principal.subject,
        username=principal.username,
        roles=frozenset(principal.authorities),
    )


{% if multi_tenancy_mode != "single" -%}
async def get_current_{{ tenant_slug }}(
    request: Request,
    principal: AuthenticatedPrincipal = Depends(require_principal),
) -> {{ tenant_class }}Context:
    """Resolve the {{ multi_tenancy_term }} from the JWT claim, header as fallback."""
    {{ tenant_column }} = principal.{{ tenant_column }} or request.headers.get(
        "X-{{ tenant_class }}-Id"
    )
    if not {{ tenant_column }}:
        raise HTTPException(
            status_code=status.HTTP_403_FORBIDDEN,
            detail="{{ MODULE_ID }}_{{ tenant_slug | upper }}_NOT_RESOLVED",
        )
    return {{ tenant_class }}Context(
        {{ tenant_column }}={{ tenant_column }},
        schema=f"{{ tenant_slug }}_{ {{- tenant_column -}} }",
    )
{%- else -%}
async def get_current_{{ tenant_slug }}() -> str:
    """Single-tenant deployment: the {{ multi_tenancy_term }} is always the default one."""
    return "default"
{%- endif %}


# D-605: this FastAPI provider used to live in application/services/. The
# application layer must not know FastAPI (ADR-001 rule: it depends on ports,
# not on the web framework), and the architecture contract test now enforces
# that. Wiring is the web layer's job, so it lives here.
def build_{{ module_id }}_service(
    session: AsyncSession = Depends(get_db),
) -> {{ ModuleId }}ApplicationService:
    """FastAPI provider -- overridden in tests with an in-memory repository."""
    from {{ package_name }}.{{ module_id }}.infrastructure.persistence.repositories import (
        SqlAlchemy{{ ModuleId }}Repository,
    )

    return {{ ModuleId }}ApplicationService(repository=SqlAlchemy{{ ModuleId }}Repository(session))
