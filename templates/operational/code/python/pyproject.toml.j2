{#-
  pyproject.toml.j2 - ROOT uv manifest for a Python backend (D-541..D-543).

  D-605: this is the manifest of the WORKSPACE, not of a service. It anchors
  the members, and owns the tooling configuration and the dev dependency set
  that the whole workspace shares. A service member is rendered from
  pyproject-service.toml.j2 — rendering THIS file for a service is what made
  `uv sync` refuse every generated Python monorepo (duplicate member name,
  then nested workspace).

  Superset of the inline fallback emitted by
  scripts/new-project.py::_backend_python(): same [project], [tool.uv.workspace],
  [tool.ruff], [tool.mypy] and [tool.pytest.ini_options] sections, plus the
  shared runtime/dev dependency set. Rendering this template replaces the
  fallback cleanly.

  Variables: project_name, project_description, python_version, package_name,
             has_ai, has_msg_broker, modules, modules_by_backend_language
-#}
{%- set _mbl = modules_by_backend_language | default({}, true) -%}
{%- set py_modules = _mbl.get('python') or modules | default([], true) -%}
{%- set services = [] -%}
{%- for m in py_modules -%}
{%- set _svc = m.backendService if m.backendService is defined and m.backendService else (m.prefix | default('', true) | lower) ~ '-service' -%}
{%- if _svc and _svc != '-service' -%}
{%- set _ = services.append(_svc) -%}
{%- endif -%}
{%- endfor -%}
{%- set py_tag = 'py' ~ python_version | replace('.', '') -%}
# Root pyproject.toml for {{ project_name }} backend (uv workspace)
# D-541: FastAPI - D-542: SQLAlchemy 2.x async - D-543: Alembic

[project]
name = "{{ project_name }}-backend"
version = "0.1.0"
description = "{{ project_description | default(project_name ~ ' backend', true) }}"
requires-python = ">={{ python_version }}"
# The root is a workspace anchor: it ships no runtime code, so it has no
# runtime dependencies. Each service member declares its own.
dependencies = []


[project.optional-dependencies]
dev = [
    "pytest>=8.3.0",
    "pytest-asyncio>=0.24.0",
    "pytest-bdd>=8.1.0",
    "pytest-cov>=6.0.0",
    "httpx>=0.27.0",
    "testcontainers[postgres]>=4.8.0",
    "ruff>=0.8.0",
    "mypy>=1.13.0",
    # D-605 Fase 1: the generated conftest imports factory-boy, which was not
    # declared anywhere — pytest failed at COLLECTION, before running a test.
    "factory-boy>=3.3.0",
]

[tool.uv.workspace]
{% if services -%}
# Service members expected (from project-context.modules.registry).
# Each is created by /py-architect-scaffold via scripts/py-scaffold.py.
{% else -%}
# Service members will be added by /py-architect-scaffold via
# scripts/py-scaffold.py.
{% endif -%}
members = [
{%- for svc in services %}
    "services/{{ svc }}",
{%- endfor %}
{%- if not services %}
    # "services/obras-service",
{%- endif %}
]

[tool.ruff]
line-length = 100
target-version = "{{ py_tag }}"
src = ["src", "services"]

[tool.ruff.lint]
select = ["E", "F", "I", "N", "UP", "B", "ASYNC"]

[tool.ruff.lint.isort]
known-first-party = ["{{ package_name }}"]

# D-605 Fase 1: B008 forbids a function call in an argument default, which is
# exactly how FastAPI declares dependencies and parameter sources. Ten of the
# twenty-one ruff errors on a freshly generated service were this rule firing on
# the framework's required idiom — there the gate was wrong, not the code.
[tool.ruff.lint.flake8-bugbear]
extend-immutable-calls = [
    "fastapi.Depends",
    "fastapi.Query",
    "fastapi.Path",
    "fastapi.Header",
    "fastapi.Cookie",
    "fastapi.Body",
    "fastapi.Form",
    "fastapi.File",
    "fastapi.Security",
]

[tool.mypy]
python_version = "{{ python_version }}"
strict = true
# D-605: the generated test scaffolding is written to be replaced, and
# factory-boy/pytest-bdd are loosely typed. --strict there put 16 of the
# 27 errors in files nobody keeps as-is. Source stays strict.
exclude = ["/tests/"]
plugins = ["pydantic.mypy"]

[[tool.mypy.overrides]]
module = ["testcontainers.*", "aio_pika.*"]
ignore_missing_imports = true

[tool.pytest.ini_options]
asyncio_mode = "auto"
testpaths = ["services"]
addopts = "-ra --strict-markers"
markers = [
    "integration: tests that require a live container (testcontainers)",
]

[tool.coverage.run]
branch = true
source = ["services"]

[tool.coverage.report]
show_missing = true
skip_empty = true
