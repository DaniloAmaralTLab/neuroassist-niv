"""Security adapter for the {{ module_name }} module.

Validates the bearer token against the issuer JWKS and projects the claims into
an `AuthenticatedPrincipal`. The rest of the application never parses tokens.
"""

from __future__ import annotations

import logging
from dataclasses import dataclass, field
from functools import lru_cache
from collections.abc import Awaitable, Callable
from typing import Any

from fastapi import Depends, HTTPException, status
from fastapi.security import HTTPAuthorizationCredentials, HTTPBearer
# D-605: PyJWT, not python-jose. The manifest declares `pyjwt[crypto]` and this
# module imported `jose` — two different libraries, so every import of the auth
# layer raised ModuleNotFoundError. Nothing caught it because nothing ran.
import jwt
from jwt import PyJWKClient, PyJWTError

from {{ package_name }}.{{ module_id }}.settings import get_settings

logger = logging.getLogger(__name__)

bearer_scheme = HTTPBearer(auto_error=False)

{%- if multi_tenancy_mode != "single" %}

# Claim carrying the {{ multi_tenancy_term }} identifier issued by the identity provider.
{{ tenant_slug | upper }}_CLAIM = "{{ tenant_column }}"
{%- endif %}


@dataclass(frozen=True, slots=True)
class AuthenticatedPrincipal:
    """Validated caller, decoupled from the token format."""

    subject: str
    username: str
    authorities: frozenset[str] = field(default_factory=frozenset)
{%- if multi_tenancy_mode != "single" %}
    {{ tenant_column }}: str | None = None
{%- endif %}
    claims: dict[str, Any] = field(default_factory=dict)


@lru_cache(maxsize=1)
def _jwks_client() -> PyJWKClient:
    """JWKS client for the issuer, cached for the process.

    D-605: PyJWKClient fetches, caches and rotates the key set and returns the
    signing key for a given token. The previous code fetched the raw JWKS JSON
    and handed the whole document to `decode` — which python-jose tolerates and
    PyJWT does not.
    """
    settings = get_settings()
    return PyJWKClient(settings.jwt_jwks_uri, cache_keys=True)


def decode_token(token: str) -> dict[str, Any]:
    """Decode and verify a bearer token, returning its claims."""
    settings = get_settings()
    try:
        signing_key = _jwks_client().get_signing_key_from_jwt(token)
        return jwt.decode(
            token,
            signing_key.key,
            algorithms=["RS256"],
            audience=settings.jwt_audience,
            issuer=settings.jwt_issuer_uri,
        )
    except PyJWTError as exc:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="{{ MODULE_ID }}_INVALID_TOKEN",
            headers={"WWW-Authenticate": "Bearer"},
        ) from exc


def to_principal(claims: dict[str, Any]) -> AuthenticatedPrincipal:
    """Project raw JWT claims onto the principal used by the application."""
    realm_roles = claims.get("realm_access", {}).get("roles", [])
    scopes = str(claims.get("scope", "")).split()
    return AuthenticatedPrincipal(
        subject=str(claims.get("sub", "")),
        username=str(claims.get("preferred_username") or claims.get("sub", "")),
        authorities=frozenset([*realm_roles, *scopes]),
{%- if multi_tenancy_mode != "single" %}
        {{ tenant_column }}=claims.get({{ tenant_slug | upper }}_CLAIM),
{%- endif %}
        claims=claims,
    )


async def require_principal(
    credentials: HTTPAuthorizationCredentials | None = Depends(bearer_scheme),
) -> AuthenticatedPrincipal:
    """FastAPI dependency: reject anonymous calls, return the principal."""
    if credentials is None or not credentials.credentials:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="{{ MODULE_ID }}_MISSING_TOKEN",
            headers={"WWW-Authenticate": "Bearer"},
        )
    return to_principal(decode_token(credentials.credentials))


def require_authority(
    authority: str,
) -> Callable[..., Awaitable[AuthenticatedPrincipal]]:
    """Dependency factory enforcing one authority, mirroring @PreAuthorize."""

    async def _guard(
        principal: AuthenticatedPrincipal = Depends(require_principal),
    ) -> AuthenticatedPrincipal:
        if authority not in principal.authorities:
            raise HTTPException(
                status_code=status.HTTP_403_FORBIDDEN,
                detail="{{ MODULE_ID }}_FORBIDDEN",
            )
        return principal

    return _guard
