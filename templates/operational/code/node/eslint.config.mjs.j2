{#-
  eslint.config.mjs.j2 — flat ESLint config for a generated NestJS service (D-603).

  Why this template exists: the scaffold emitted a `lint` script and the
  `eslintBoundaries` gate but NO config file at all, so `pnpm lint` died with
  "ESLint couldn't find an eslint.config.(js|mjs|cjs) file" on every generated
  service. ESLint 9 dropped .eslintrc; flat config is the only supported form.

  Two deliberate constraints on how this is written:

  1. It imports ONLY what the service package.json declares
     (@typescript-eslint/parser, @typescript-eslint/eslint-plugin,
     eslint-config-prettier). pnpm's node_modules is strict, so reaching for the
     `typescript-eslint` meta-package or `@eslint/js` — neither declared — would
     fail at load time. Verbosity here beats adding a dependency to make a
     linter start.

  2. The layering rules use the BUILT-IN `no-restricted-imports` instead of
     eslint-plugin-boundaries. They are the node counterpart of the JVM ArchUnit
     gate (RULE-01..09); adding a dependency just so a gate can run is a worse
     trade than expressing the same constraint with what is already installed.

  Vars: svc.
-#}
// @ts-check
import tsParser from '@typescript-eslint/parser';
import tsPlugin from '@typescript-eslint/eslint-plugin';
import prettier from 'eslint-config-prettier';

/**
 * ESLint (flat config) for {{ svc }}.
 *
 * Hexagonal boundaries (RULE-01..09 equivalent):
 *   domain/          pure — no Nest, no Prisma, no infrastructure, no modules
 *   modules/         may use Nest; reaches persistence only through the ports
 *   infrastructure/  the only layer allowed to import Prisma
 */
export default [
  {
    ignores: [
      'dist/**',
      'node_modules/**',
      'coverage/**',
      'coverage-e2e/**',
      'prisma/migrations/**',
      'eslint.config.mjs',
    ],
  },
  {
    files: ['**/*.ts'],
    languageOptions: {
      parser: tsParser,
      ecmaVersion: 2023,
      sourceType: 'module',
      parserOptions: { sourceType: 'module' },
    },
    plugins: { '@typescript-eslint': tsPlugin },
    rules: {
      ...tsPlugin.configs.recommended.rules,
      ...prettier.rules,
      // The scaffold ships intentional stubs; an argument prefixed with _ is a
      // declaration of intent, not an oversight.
      '@typescript-eslint/no-unused-vars': [
        'error',
        { argsIgnorePattern: '^_', varsIgnorePattern: '^_' },
      ],
      '@typescript-eslint/no-explicit-any': 'warn',
    },
  },
  {
    // RULE — the domain stays pure. It must not know Nest, Prisma, HTTP or any
    // outer layer; this is what ArchUnit enforces on the JVM side.
    files: ['src/domain/**/*.ts'],
    rules: {
      'no-restricted-imports': [
        'error',
        {
          patterns: [
            {
              group: [
                '@nestjs/*',
                '@prisma/client',
                'prisma',
                '**/infrastructure/**',
                '**/modules/**',
              ],
              message:
                'The domain layer must stay pure: no Nest, no Prisma, no ' +
                'infrastructure and no module imports. Invert the dependency ' +
                'through a port declared in the domain instead.',
            },
          ],
        },
      ],
    },
  },
  {
    // RULE — feature modules reach persistence through the domain ports, never
    // through Prisma directly.
    files: ['src/modules/**/*.ts'],
    rules: {
      'no-restricted-imports': [
        'error',
        {
          patterns: [
            {
              group: ['@prisma/client', 'prisma'],
              message:
                'Feature modules must not import Prisma directly. Depend on ' +
                'the repository port from the domain; the Prisma adapter lives ' +
                'in infrastructure/persistence.',
            },
          ],
        },
      ],
    },
  },
  {
    // Specs may reach wherever they need to in order to assert.
    files: ['**/*.spec.ts', '**/*.e2e-spec.ts', 'test/**/*.ts'],
    rules: {
      'no-restricted-imports': 'off',
      '@typescript-eslint/no-explicit-any': 'off',
    },
  },
];
