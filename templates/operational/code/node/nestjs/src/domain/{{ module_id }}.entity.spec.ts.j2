{#-
  {{ module_id }}.entity.spec.ts.j2 — unit spec for the aggregate root (D-603).

  Why this template exists: `pnpm test` runs jest with rootDir=src, and the
  scaffold shipped no spec under src/ at all — jest exited 1 with "0 matches in
  20 files" and the gate was red on every generated service. Adding
  `--passWithNoTests` would have turned it green over nothing; the aggregate
  already declares invariants, so there is something real to assert.

  Vars: module_id, ModuleId, MODULE_ID, tenant_field, multi_tenancy_mode.
-#}
import { {{ ModuleId }}Entity, {{ ModuleId }}Status } from './{{ module_id }}.entity';

/**
 * Unit spec for the {{ MODULE_ID }} aggregate root.
 *
 * Covers the invariants the entity enforces itself — no Nest, no Prisma, no
 * HTTP. Generated by node-module-generator; extend it as the real aggregate
 * replaces the skeleton.
 */
describe('{{ ModuleId }}Entity', () => {
  const validProps = () => ({
    id: '11111111-1111-4111-8111-111111111111',
    name: 'Valid name',
    description: 'optional',
    status: {{ ModuleId }}Status.ACTIVE,
{%- if multi_tenancy_mode and multi_tenancy_mode != 'none' %}
    {{ tenant_field }}: '22222222-2222-4222-8222-222222222222',
{%- endif %}
    createdAt: new Date('2020-01-01T00:00:00Z'),
    updatedAt: new Date('2020-01-01T00:00:00Z'),
  });

  it('builds from valid props', () => {
    const entity = new {{ ModuleId }}Entity(validProps());

    expect(entity.id).toBe(validProps().id);
    expect(entity.isActive()).toBe(true);
{%- if multi_tenancy_mode and multi_tenancy_mode != 'none' %}
    expect(entity.{{ tenant_field }}).toBe(validProps().{{ tenant_field }});
{%- endif %}
  });

  it('rejects a missing id', () => {
    expect(() => new {{ ModuleId }}Entity({ ...validProps(), id: '' })).toThrow(
      /id is required/,
    );
  });

  it('rejects a name shorter than two characters', () => {
    expect(() => new {{ ModuleId }}Entity({ ...validProps(), name: 'a' })).toThrow(
      /at least 2 characters/,
    );
  });

  it('rejects a name that is only whitespace', () => {
    expect(() => new {{ ModuleId }}Entity({ ...validProps(), name: '   ' })).toThrow(
      /at least 2 characters/,
    );
  });
{%- if multi_tenancy_mode and multi_tenancy_mode != 'none' %}

  it('rejects a missing {{ tenant_field }} — every query is scoped by it', () => {
    expect(
      () => new {{ ModuleId }}Entity({ ...validProps(), {{ tenant_field }}: '' }),
    ).toThrow();
  });
{%- endif %}

  it('with() returns a new instance and refreshes updatedAt', () => {
    const original = new {{ ModuleId }}Entity(validProps());
    const renamed = original.with({ name: 'Renamed' });

    expect(renamed).not.toBe(original);
    expect(renamed.name).toBe('Renamed');
    expect(original.name).toBe(validProps().name);
    expect(renamed.updatedAt.getTime()).toBeGreaterThan(
      original.updatedAt.getTime(),
    );
  });

  it('with() keeps identity and creation time', () => {
    const original = new {{ ModuleId }}Entity(validProps());
    const changed = original.with({ name: 'Other name' });

    expect(changed.id).toBe(original.id);
    expect(changed.createdAt).toEqual(original.createdAt);
{%- if multi_tenancy_mode and multi_tenancy_mode != 'none' %}
    expect(changed.{{ tenant_field }}).toBe(original.{{ tenant_field }});
{%- endif %}
  });

  it('archive() moves the aggregate out of the active state', () => {
    const archived = new {{ ModuleId }}Entity(validProps()).archive();

    expect(archived.status).toBe({{ ModuleId }}Status.ARCHIVED);
    expect(archived.isActive()).toBe(false);
  });
});
