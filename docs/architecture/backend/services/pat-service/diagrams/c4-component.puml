@startuml pat-c4-component
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.9.0/C4_Component.puml
title PAT — Component (hexagonal, key hexagonal_java)

Container_Boundary(api, "pat-service (com.neuroassist.pat)") {

  Component(ctl, "api/", "Spring Web", "PatientController, CommandController, GestureTypeController; request/response DTOs + mappers; @PreAuthorize strings == RoleAuthorityPolicy")

  Component(app, "application/", "Use-case services", "RegisterPatient, DeactivatePatient, ReactivatePatient, CreateCommand, CalibrateCommand, RetireCommand, ReadCatalog, RegisterGestureType; @Transactional; HIST audit orchestration")

  Component(dom, "domain/", "Model + ports", "Patient, Command, GestureType; VOs GestureComposition, CalibrationWindow, UrgencyLevel, Sensitivity; ports: PatientRepository, CommandRepository, GestureTypeRepository, HistAuditPort, AcsIntrospectionPort; RoleAuthorityPolicy (authority constants)")

  Component(infra, "infrastructure/", "Adapters", "JPA repositories (schema-per-tenant routing); HIST + ACS HTTP clients; Spring Security resource-server config (JWKS); ETag computation")
}

ContainerDb(db, "PostgreSQL", "global + t_<tenantId>")
System_Ext(acs, "ACS", "JWKS / introspect")
System_Ext(hist, "HIST", "Audit")

Rel(ctl, app, "invokes use cases")
Rel(app, dom, "depends on domain + ports")
Rel(infra, dom, "implements ports (inward dependency)")
Rel(infra, db, "JPA / JDBC")
Rel(infra, acs, "JWKS / introspect")
Rel(infra, hist, "POST /audit")

note right of dom
  Dependency rule (ADR hexagonal_java):
  domain imports nothing outward;
  application depends on domain;
  api and infrastructure depend inward.
end note
@enduml
